{
  // Production code only. Composite, so the tests project below checks against
  // this project's emitted `.d.ts` instead of re-checking all of `src`; that
  // split is what keeps tsc's peak heap near the size of one half (see
  // docs/agents/testing-and-ci.md). Nothing here is shipped: the declarations
  // land in the ignored `.cache` dir.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "./.cache/tsc/src",
    "tsBuildInfoFile": "./.cache/tsc/src.tsbuildinfo"
  },
  "include": [
    "src",
    "src/**/*.json",
    // Imported across the boundary by `src`: the callable manifest, the Corp Tax
    // Book engine, and the import-free rules that live once here.
    "functions/src/callableManifest.ts",
    "functions/src/corpTaxBookEngine.ts",
    "functions/src/corpTaxBookMoonDocs.ts",
    "functions/src/corpTaxBookLateNotice.ts",
    "functions/src/corpTaxBookCheckpoint.ts",
    "functions/src/corpTaxBookReadModels.ts",
    "functions/src/corpTaxBookAccounts.ts",
    "functions/src/corpTaxBookDonationMatch.ts",
    "functions/src/corpTaxBookTransferMatch.ts",
    "functions/src/corpTaxBookMatchRows.ts",
    "functions/src/corpTaxBookSchedule.ts",
    "functions/src/corpTaxBookVersionKeys.ts",
    "functions/src/popSharing.ts",
    "functions/src/sharedPops.ts",
    "functions/src/guards.ts",
    "functions/src/chunk.ts",
    "functions/src/asyncPool.ts",
    "functions/src/vettingEngine.ts",
    "functions/src/skyhookAlert.ts",
    "functions/src/jumpRoute.ts",
    "functions/src/incursionAlert.ts",
    "functions/src/incursionState.ts",
    "functions/src/srpPricing.ts",
    "functions/src/srpDoctrine.ts",
    "functions/src/timeConstants.ts",
    "functions/src/verifyToken.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/__tests__/**/*",
    "src/**/test-helpers.ts",
    "src/test/**/*",
    "src/**/*.stories.tsx"
  ]
}
