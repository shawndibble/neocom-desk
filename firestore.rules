rules_version = '2';

// Sync data only: user-editable Skill Plans, Build Plans, Quickbars, Station
// Pins + synced settings, per character. uid format is "char:{characterId}" (minted by the
// mintFirebaseToken function after verifying an EVE access token against
// CCP's JWKS).
//
// Owner-hash guard: every doc stores the ownerHash it was written under, and
// the auth token carries the current ownerHash as a custom claim. If a
// character is sold/transferred, EVE issues a new ownerHash, so the new owner
// authenticates with the same uid but a different claim: existing docs stop
// being gettable or updatable (no data leak). Delete stays uid-only so the new
// owner can purge the stale docs and start fresh.
//
// get vs list: single-doc reads stay hash-strict. list is uid-only — with a
// hash-strict list rule, a single stale-hash doc left over from a transfer
// would make EVERY query fail (rules must be provable for all possible
// results), bricking sync. The client always queries with
// where('ownerHash', '==', <current hash>), so stale docs never reach it.
service cloud.firestore {
  match /databases/{database}/documents {
    match /characters/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function hashMatches() {
        return resource.data.ownerHash == request.auth.token.ownerHash;
      }
      function incomingHashMatches() {
        return request.resource.data.ownerHash == request.auth.token.ownerHash;
      }

      // Last-synced heartbeat (issue #2065): the parent doc holds one field,
      // stamped after each successful sync, which the scheduled
      // purgeStaleAccounts function reads. Owner-only, that one field only —
      // no ownerHash guard, it carries no user data.
      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly(['lastSyncedAt'])
        && request.resource.data.lastSyncedAt is number;

      match /plans/{planId} {
        allow get: if isOwner() && hashMatches();
        allow list: if isOwner();
        allow create: if isOwner() && incomingHashMatches();
        allow update: if isOwner() && hashMatches() && incomingHashMatches();
        allow delete: if isOwner();
      }

      match /buildPlans/{planId} {
        allow get: if isOwner() && hashMatches();
        allow list: if isOwner();
        allow create: if isOwner() && incomingHashMatches();
        allow update: if isOwner() && hashMatches() && incomingHashMatches();
        allow delete: if isOwner();
      }

      match /quickbars/{quickbarId} {
        allow get: if isOwner() && hashMatches();
        allow list: if isOwner();
        allow create: if isOwner() && incomingHashMatches();
        allow update: if isOwner() && hashMatches() && incomingHashMatches();
        allow delete: if isOwner();
      }

      match /stationPins/{pinId} {
        allow get: if isOwner() && hashMatches();
        allow list: if isOwner();
        allow create: if isOwner() && incomingHashMatches();
        allow update: if isOwner() && hashMatches() && incomingHashMatches();
        allow delete: if isOwner();
      }

      // Doc id is "{characterId}:{planetId}" (planSync.ts planetRichnessId).
      match /planetRichness/{richnessId} {
        allow get: if isOwner() && hashMatches();
        allow list: if isOwner();
        allow create: if isOwner() && incomingHashMatches();
        allow update: if isOwner() && hashMatches() && incomingHashMatches();
        allow delete: if isOwner();
      }

      // Moon Mining Tax ledger (issue #523): Payees and Assignments are
      // per-character Editable Data, synced exactly like plans.
      match /payees/{payeeId} {
        allow get: if isOwner() && hashMatches();
        allow list: if isOwner();
        allow create: if isOwner() && incomingHashMatches();
        allow update: if isOwner() && hashMatches() && incomingHashMatches();
        allow delete: if isOwner();
      }

      // My Fittings (issue #1538): saved Fitting share codes, per-character
      // Editable Data synced exactly like plans.
      match /fittings/{fittingId} {
        allow get: if isOwner() && hashMatches();
        allow list: if isOwner();
        allow create: if isOwner() && incomingHashMatches();
        allow update: if isOwner() && hashMatches() && incomingHashMatches();
        allow delete: if isOwner();
      }

      match /miningTaxAssignments/{assignmentId} {
        allow get: if isOwner() && hashMatches();
        allow list: if isOwner();
        allow create: if isOwner() && incomingHashMatches();
        allow update: if isOwner() && hashMatches() && incomingHashMatches();
        allow delete: if isOwner();
      }

      match /settings/{key} {
        allow get: if isOwner() && hashMatches();
        allow list: if isOwner();
        allow create: if isOwner() && incomingHashMatches();
        allow update: if isOwner() && hashMatches() && incomingHashMatches();
        allow delete: if isOwner();
      }

      // This collection carries no tombstones (dismissal is a flag — issue
      // #362), but the sync path does delete here: a row past the synced
      // window is purged outright rather than tombstoned (issue #582), which
      // is what keeps the collection bounded. `delete` is granted uid-only,
      // like every sibling collection above — covering that retention purge.
      match /notificationFeed/{occurrenceKey} {
        allow get: if isOwner() && hashMatches();
        allow list: if isOwner();
        allow create: if isOwner() && incomingHashMatches();
        allow update: if isOwner() && hashMatches() && incomingHashMatches();
        allow delete: if isOwner();
      }

      match /productionRuns/{runId} {
        allow get: if isOwner() && hashMatches();
        allow list: if isOwner();
        allow create: if isOwner() && incomingHashMatches();
        allow update: if isOwner() && hashMatches() && incomingHashMatches();
        allow delete: if isOwner();
      }

      match /productionSaleLinks/{linkId} {
        allow get: if isOwner() && hashMatches();
        allow list: if isOwner();
        allow create: if isOwner() && incomingHashMatches();
        allow update: if isOwner() && hashMatches() && incomingHashMatches();
        allow delete: if isOwner();
      }

      match /productionOrderWatches/{watchId} {
        allow get: if isOwner() && hashMatches();
        allow list: if isOwner();
        allow create: if isOwner() && incomingHashMatches();
        allow update: if isOwner() && hashMatches() && incomingHashMatches();
        allow delete: if isOwner();
      }
    }

    // Device registrations (issue #356, ADR 0010): written only by the
    // registerDevice callable using admin privileges, because syncAuth.ts
    // signs in as one Character (uid char:{id}) while a device registration
    // covers every Character it holds at once. No ownerHash pattern applies
    // here — deny all client access, matching the Projection collection
    // below (#358).
    match /deviceRegistrations/{deviceId} {
      allow read, write: if false;
    }

    // Projection rows (issue #358, ADR 0010, CONTEXT.md round 45): one doc
    // per device per occurrence, doc id `{deviceId}:{Occurrence Key}` (issue
    // #2240; legacy rows keep the bare Occurrence Key). Written by registerDevice
    // (upload) and dispatchProjections (fire/purge), both admin-privileged —
    // same reasoning as deviceRegistrations above: a per-device upload covers
    // every Character it holds at once, which the ownerHash/uid pattern
    // cannot express. Deny all client access.
    match /projections/{occurrenceKey} {
      allow read, write: if false;
    }

    // Public contract search (issues #608, #906, ADR 0013): one of the two
    // top-level collections that aren't per-Character sync data — the other is
    // publicCourierContracts just below, fed by the same job. Written only
    // by the syncPublicContractOffers scheduled function (admin privileges);
    // read by any signed-in client, since the underlying data (EVE's public
    // contract market) is not scoped to a Character or its ownerHash at all.
    // It replaced the blueprint-copies-only publicBpcContracts collection in
    // #907, which BPC Sourcing now filters out of this one client-side.
    // Rules end in an implicit deny, so without this block the collection is
    // unreadable no matter what the sync writes.
    match /publicContractOffers/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // The courier half of the same crawl (#909): public courier contracts as a
    // route and a fee, which carry no item lines and so none of the offer row's
    // fields. Same sync, same admin-only write, same signed-in read — a
    // sibling collection only because it is a different row shape.
    // The index beside the offers chunks (#2921): per item type, how many
    // offers, the cheapest, and which chunk docs hold them. Its own
    // collection because an older client reads the whole offers collection and
    // treats every doc that is not `meta` as a chunk of rows.
    match /publicContractOffersIndex/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /publicCourierContracts/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // Mining Yield Overview's server-side price history (issue #1279): one
    // doc per UTC date, written only by the captureMiningPriceSnapshot
    // scheduled function (admin privileges). Not per-Character sync data —
    // it's public market history — so it gets the same rule as the two
    // collections above: read by any signed-in client, never client-written.
    match /marketHistory/{date} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // Route Safety's lawless (insurgency) systems (issue #2870): one doc,
    // `lawless`, written only by the syncLawlessSystems scheduled function
    // (admin privileges). Public EVE data, so the same rule as the market
    // collections above: read by any signed-in client, never client-written.
    match /systemConditions/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // EVE Workbench fits by hull (issue #2484): the Popular fit panel's EVE
    // Workbench tab. Written only by the syncWorkbenchFits scheduled function
    // (admin privileges). Readable with no session at all, unlike the public
    // collections above: the data is EVE Workbench's own public fit list, and
    // the fitter works with nobody logged in, so a sign-in gate would hide
    // public fits from exactly the pilot browsing hulls before adding a
    // Character. `get` only, never `list`: with no sign-in at all, a public
    // list would let anyone page through all ~38k fits (EFT included) and run
    // up our read bill. The client reads a hull by id instead — part
    // `{shipTypeId}_0`, whose `parts` field says how many `_1.._{n-1}` docs to
    // fetch (features/fittings/workbenchFits.ts). The sync's checkpoint lives
    // in workbenchFitsSync, which has no rule and so stays denied by the
    // implicit deny below.
    match /workbenchFits/{docId} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }
    // Stored Share Links (src/features/share/shareStore.ts): a short
    // /share/{id} URL whose content lives here for a week. Not per-Character
    // data, and the person opening a link may have no account at all — so
    // `get` is public, by id only. `list` stays denied: the 9-character
    // random id is what keeps a share private to whoever holds the link, and
    // listing would hand every id out. An expired doc is refused here as well
    // as hidden by the client, because the TTL policy (firestore.indexes.json)
    // deletes it up to a day late. A missing doc is refused too (no
    // `resource` to read), which the client reads the same as expired.
    //
    // Any signed-in Character may create one. The doc carries no uid: anyone
    // with the link reads all of it. Create-only — no update or delete — so a
    // share can't be rewritten after it was sent, and a write to a taken id is
    // refused rather than merged. `type` mirrors SHARE_TYPES; the appraisal
    // item cap mirrors MAX_SNAPSHOT_ITEMS, the fitting code cap
    // MAX_FITTING_SHARE_CODE_LENGTH. `expiresAt` allows a day of client
    // clock skew past the 7 the client asks for.
    match /shares/{shareId} {
      allow get: if resource.data.expiresAt > request.time;
      allow list: if false;
      allow create: if request.auth != null
        && shareId.matches('^[0-9A-Za-z]{9}$')
        && request.resource.data.keys().hasOnly(['type', 'payload', 'createdAt', 'expiresAt'])
        && request.resource.data.keys().hasAll(['type', 'payload', 'createdAt', 'expiresAt'])
        && request.resource.data.type in ['appraisal', 'fitting']
        && request.resource.data.payload is map
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(8, 'd')
        && (request.resource.data.type != 'appraisal'
          || (request.resource.data.payload.items is list
            && request.resource.data.payload.items.size() <= 1000))
        && (request.resource.data.type != 'fitting'
          || (request.resource.data.payload.code is string
            && request.resource.data.payload.code.size() <= 20100));
      allow update, delete: if false;
    }
    // Everything else: implicit deny.
  }
}
