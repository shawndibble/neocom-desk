rules_version = '2';

// Sync data only: user-editable Skill Plans, Build Plans, Quickbars, Station
// Pins + synced settings, per character. uid format is "char:{characterId}" (minted by the
// mintFirebaseToken function after verifying an EVE access token against
// CCP's JWKS).
//
// Owner-hash guard: every doc stores the ownerHash it was written under, and
// the auth token carries the current ownerHash as a custom claim. If a
// character is sold/transferred, EVE issues a new ownerHash, so the new owner
// authenticates with the same uid but a different claim: existing docs stop
// being gettable or updatable (no data leak). Delete stays uid-only so the new
// owner can purge the stale docs and start fresh.
//
// get vs list: single-doc reads stay hash-strict. list is uid-only — with a
// hash-strict list rule, a single stale-hash doc left over from a transfer
// would make EVERY query fail (rules must be provable for all possible
// results), bricking sync. The client always queries with
// where('ownerHash', '==', <current hash>), so stale docs never reach it.
service cloud.firestore {
  match /databases/{database}/documents {
    match /characters/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function hashMatches() {
        return resource.data.ownerHash == request.auth.token.ownerHash;
      }
      function incomingHashMatches() {
        return request.resource.data.ownerHash == request.auth.token.ownerHash;
      }

      match /plans/{planId} {
        allow get: if isOwner() && hashMatches();
        allow list: if isOwner();
        allow create: if isOwner() && incomingHashMatches();
        allow update: if isOwner() && hashMatches() && incomingHashMatches();
        allow delete: if isOwner();
      }

      match /buildPlans/{planId} {
        allow get: if isOwner() && hashMatches();
        allow list: if isOwner();
        allow create: if isOwner() && incomingHashMatches();
        allow update: if isOwner() && hashMatches() && incomingHashMatches();
        allow delete: if isOwner();
      }

      match /quickbars/{quickbarId} {
        allow get: if isOwner() && hashMatches();
        allow list: if isOwner();
        allow create: if isOwner() && incomingHashMatches();
        allow update: if isOwner() && hashMatches() && incomingHashMatches();
        allow delete: if isOwner();
      }

      match /stationPins/{pinId} {
        allow get: if isOwner() && hashMatches();
        allow list: if isOwner();
        allow create: if isOwner() && incomingHashMatches();
        allow update: if isOwner() && hashMatches() && incomingHashMatches();
        allow delete: if isOwner();
      }

      // Doc id is "{characterId}:{planetId}" (planSync.ts planetRichnessId).
      match /planetRichness/{richnessId} {
        allow get: if isOwner() && hashMatches();
        allow list: if isOwner();
        allow create: if isOwner() && incomingHashMatches();
        allow update: if isOwner() && hashMatches() && incomingHashMatches();
        allow delete: if isOwner();
      }

      // Moon Mining Tax ledger (issue #523): Payees and Assignments are
      // per-character Editable Data, synced exactly like plans.
      match /payees/{payeeId} {
        allow get: if isOwner() && hashMatches();
        allow list: if isOwner();
        allow create: if isOwner() && incomingHashMatches();
        allow update: if isOwner() && hashMatches() && incomingHashMatches();
        allow delete: if isOwner();
      }

      match /miningTaxAssignments/{assignmentId} {
        allow get: if isOwner() && hashMatches();
        allow list: if isOwner();
        allow create: if isOwner() && incomingHashMatches();
        allow update: if isOwner() && hashMatches() && incomingHashMatches();
        allow delete: if isOwner();
      }

      match /settings/{key} {
        allow get: if isOwner() && hashMatches();
        allow list: if isOwner();
        allow create: if isOwner() && incomingHashMatches();
        allow update: if isOwner() && hashMatches() && incomingHashMatches();
        allow delete: if isOwner();
      }

      // This collection carries no tombstones (dismissal is a flag — issue
      // #362), so nothing in the sync path ever deletes a row here. `delete`
      // is still granted uid-only, like every sibling collection above, so
      // characterPurge.ts can clear a dropped Character's rows.
      match /notificationFeed/{occurrenceKey} {
        allow get: if isOwner() && hashMatches();
        allow list: if isOwner();
        allow create: if isOwner() && incomingHashMatches();
        allow update: if isOwner() && hashMatches() && incomingHashMatches();
        allow delete: if isOwner();
      }

      match /productionRuns/{runId} {
        allow get: if isOwner() && hashMatches();
        allow list: if isOwner();
        allow create: if isOwner() && incomingHashMatches();
        allow update: if isOwner() && hashMatches() && incomingHashMatches();
        allow delete: if isOwner();
      }

      match /productionSaleLinks/{linkId} {
        allow get: if isOwner() && hashMatches();
        allow list: if isOwner();
        allow create: if isOwner() && incomingHashMatches();
        allow update: if isOwner() && hashMatches() && incomingHashMatches();
        allow delete: if isOwner();
      }

      match /productionOrderWatches/{watchId} {
        allow get: if isOwner() && hashMatches();
        allow list: if isOwner();
        allow create: if isOwner() && incomingHashMatches();
        allow update: if isOwner() && hashMatches() && incomingHashMatches();
        allow delete: if isOwner();
      }
    }

    // Device registrations (issue #356, ADR 0010): written only by the
    // registerDevice callable using admin privileges, because syncAuth.ts
    // signs in as one Character (uid char:{id}) while a device registration
    // covers every Character it holds at once. No ownerHash pattern applies
    // here — deny all client access, matching the Projection collection
    // below (#358).
    match /deviceRegistrations/{deviceId} {
      allow read, write: if false;
    }

    // Projection rows (issue #358, ADR 0010, CONTEXT.md round 45): one doc
    // per occurrence, doc id === Occurrence Key. Written by registerDevice
    // (upload) and dispatchProjections (fire/purge), both admin-privileged —
    // same reasoning as deviceRegistrations above: a per-device upload covers
    // every Character it holds at once, which the ownerHash/uid pattern
    // cannot express. Deny all client access.
    match /projections/{occurrenceKey} {
      allow read, write: if false;
    }
    // Everything else: implicit deny.
  }
}
