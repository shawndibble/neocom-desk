{
  "name": "neocom-desk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "homepage": "https://neocomdesk.com",
  "scripts": {
    "dev": "vite",
    "build": "tsc --project tsconfig.build.json && npm run build:bundle",
    "build:bundle": "vite build && node scripts/check-sw.mjs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check:case": "node scripts/check-case-collisions.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "emulators": "node scripts/dev/emulators.mjs",
    "emulators:seed": "node scripts/dev/seed-corp-tax-book.mjs",
    "test:rules": "npx --yes firebase-tools@14.27.0 emulators:exec --only firestore --project demo-neocom-rules \"vitest run --config vitest.rules.config.ts && npm run test:emulator --prefix functions\"",
    "test:e2e": "playwright test",
    "sde:build": "node scripts/build-sde.mjs",
    "sde:verify": "node scripts/sde-verify.mjs",
    "sde:fitting-slots": "node scripts/build-fitting-slots.mjs",
    "prepare": "husky && node scripts/verify-husky.mjs",
    "verify-hooks": "node scripts/verify-husky.mjs",
    "storybook": "node scripts/storybook.mjs",
    "ui:catalog": "node scripts/ui-catalog.mjs",
    "shots:resize": "node scripts/resize-screenshots.mjs",
    "ui:shot": "node scripts/ui-shot.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,css,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@eveshipfit/dogma-engine": "13.0.1",
    "@eveshipfit/sde": "7.3542233.0",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/react": "^10.73.0",
    "@tanstack/react-virtual": "^3.14.10",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-bold": "3.32.0",
    "@tiptap/extension-document": "3.32.0",
    "@tiptap/extension-hard-break": "3.32.0",
    "@tiptap/extension-italic": "3.32.0",
    "@tiptap/extension-link": "3.32.0",
    "@tiptap/extension-paragraph": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-text": "3.32.0",
    "@tiptap/extension-underline": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@use-gesture/react": "^10.3.1",
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^4.4.0",
    "fflate": "^0.8.3",
    "firebase": "^12.18.0",
    "i18next": "^26.4.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.62.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@sentry/vite-plugin": "^5.4.0",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-mcp": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/babel__core": "^7.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/ui": "^4.1.11",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.4.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "@swc/core@1.16.1": true,
    "msw@2.15.0": true,
    "protobufjs@7.6.6": true
  },
  "overrides": {
    "workbox-build": {
      "glob": "^13.0.0"
    }
  }
}
